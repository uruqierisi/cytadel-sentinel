{
  "name": "cytadel-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "Cytadel Sentinel — authorized, scope-gated web-application penetration-testing pipeline. Deterministic tooling only; no LLM at runtime.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sentinel": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx cli.ts",
    "sentinel": "tsx cli.ts",
    "setup": "bash scripts/setup.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "commander": "^12.1.0",
    "ioredis": "^5.4.2",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
