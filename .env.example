# ---------------------------------------------------------------------------
# Cytadel Sentinel — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env. Secrets are read from env, never from scope YAML.
# ---------------------------------------------------------------------------

# --- Postgres (Prisma) -----------------------------------------------------
DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinel?schema=public"

# --- Redis (BullMQ) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- DefectDojo ------------------------------------------------------------
# Admin URL is printed by setup.sh once the container is healthy.
DEFECTDOJO_URL="http://localhost:8080"
# Get the API key: log in to the URL above -> top-right user -> "API v2 Key".
DEFECTDOJO_API_KEY=""

# --- Authenticated scanning session material -------------------------------
# The scope YAML references an env var name (e.g. SENTINEL_SESSION_COOKIE);
# the actual secret value lives here and is injected at runtime only.
SENTINEL_SESSION_COOKIE=""
SENTINEL_SESSION_HEADER=""

# --- Runtime identity (who triggered the run, for the audit log) -----------
# Falls back to the OS user if unset.
SENTINEL_ACTOR=""

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"
# Pretty-print logs (set to 0 in CI / production for JSON lines).
LOG_PRETTY="1"
