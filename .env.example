# ---------------------------------------------------------------------------
# Cytadel Sentinel — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env. Secrets are read from env, never from scope YAML.
# ---------------------------------------------------------------------------

# --- Postgres (Prisma) -----------------------------------------------------
DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinel?schema=public"

# --- Redis (BullMQ) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- DefectDojo ------------------------------------------------------------
# Admin URL is printed by setup.sh once the container is healthy.
DEFECTDOJO_URL="http://localhost:8080"
# Get the API key: log in to the URL above -> top-right user -> "API v2 Key".
DEFECTDOJO_API_KEY=""

# --- Authenticated scanning session material -------------------------------
# The scope YAML references an env var name (e.g. SENTINEL_SESSION_COOKIE);
# the actual secret value lives here and is injected at runtime only.
SENTINEL_SESSION_COOKIE=""
SENTINEL_SESSION_HEADER=""

# --- Runtime identity (who triggered the run, for the audit log) -----------
# Falls back to the OS user if unset.
SENTINEL_ACTOR=""

# --- Logging & terminal UI -------------------------------------------------
# LOG_LEVEL controls the FILE log verbosity only (logs/sentinel.log in pretty
# mode, or stdout JSON in CI/--json mode). debug | info | warn | error
LOG_LEVEL="info"
# Terminal presentation: auto (default) | pretty | json.
#   auto   -> pretty CLI on a TTY; raw JSON lines in CI / non-TTY / with --json
#   pretty -> force the human reporter
#   json   -> force raw JSON lines (piping / CI)
SENTINEL_UI="auto"

# --- Recon / scan tuning (all optional; safe defaults) ---------------------
# Max non-JS endpoints kept per host after gating (stops one noisy archive
# source from exploding the scan). Default 300.
SENTINEL_MAX_ENDPOINTS_PER_HOST="300"
# JS/static assets are capped in a SEPARATE bucket so retire.js always has input
# (the endpoint cap never starves JS). Default 200.
SENTINEL_MAX_JS_ASSETS_PER_HOST="200"
# How often a long-running tool emits an elapsed-time heartbeat (ms). Default 60000.
SENTINEL_PROGRESS_INTERVAL_MS="60000"
# Per-tool hard timeouts in ms (defaults shown). Lower nuclei to bound scan time.
# On a kill/timeout, tools keep whatever partial output they wrote (never discarded).
SENTINEL_NUCLEI_TIMEOUT_MS="900000"
SENTINEL_NIKTO_TIMEOUT_MS="480000"
SENTINEL_TESTSSL_TIMEOUT_MS="600000"
SENTINEL_KATANA_TIMEOUT_MS="300000"
SENTINEL_GAU_TIMEOUT_MS="180000"
SENTINEL_WAYBACKURLS_TIMEOUT_MS="180000"
# SENTINEL_SUBFINDER_TIMEOUT_MS / _HTTPX_TIMEOUT_MS / _NAABU_TIMEOUT_MS / _RETIRE_TIMEOUT_MS also honored.

# nuclei speed caps (per-request), keeps the tag scope but bounds request volume.
SENTINEL_NUCLEI_TAGS="cve,misconfiguration,exposure,tech"
SENTINEL_NUCLEI_REQ_TIMEOUT_SEC="10"
SENTINEL_NUCLEI_RETRIES="1"
SENTINEL_NUCLEI_CONCURRENCY="25"
# nuclei is fed deduped base URLs + unique query-stripped paths (NOT every param
# URL). This is the main lever so nuclei finishes instead of hitting its timeout.
SENTINEL_NUCLEI_MAX_TARGETS="150"

# Active injection (dalfox/sqlmap) — only runs behind the destructive gate.
# Targets are deduped by (path + param NAME) first (?id=1 and ?id=2 count once),
# then capped to this many distinct injection signatures.
SENTINEL_MAX_INJECTION_TARGETS="25"
# dalfox speed knobs — make it FINISH each batch (so it emits a complete JSON
# array) instead of being killed mid-write. Targets run in batches under an
# overall wall-clock budget, mirroring sqlmap.
SENTINEL_DALFOX_WORKER="100"                # concurrent workers
SENTINEL_DALFOX_REQ_TIMEOUT_SEC="10"        # per-request timeout
SENTINEL_DALFOX_SKIP_BAV="1"                # skip Basic-Another-Vuln sweep (faster); 0 to enable
SENTINEL_DALFOX_BLIND_URL=""                # optional blind-XSS callback; empty = off
SENTINEL_DALFOX_BATCH_SIZE="10"             # signatures per dalfox pipe invocation
SENTINEL_DALFOX_BATCH_TIMEOUT_MS="180000"   # hard cap PER batch
SENTINEL_DALFOX_BUDGET_MS="480000"          # overall wall-clock budget for dalfox
# sqlmap knobs. sqlmap only runs behind the destructive gate, so defaults are
# tuned for DETECTION: level/risk 2 and time-based (T) in the technique set —
# blind SQLi (e.g. Juice Shop's SQLite search) needs the depth. Dial back for
# speed with LEVEL=1 RISK=1 TECHNIQUE="BEU" if a run is too slow.
SENTINEL_SQLMAP_LEVEL="2"
SENTINEL_SQLMAP_RISK="2"
SENTINEL_SQLMAP_TECHNIQUE="BEUT"         # B=boolean E=error U=union T=time-based (S=stacked left out, slowest)
SENTINEL_SQLMAP_THREADS="4"
SENTINEL_SQLMAP_REQ_TIMEOUT_SEC="10"
SENTINEL_SQLMAP_RETRIES="1"
SENTINEL_SQLMAP_TARGET_TIMEOUT_MS="90000"   # hard cap PER target (not per run)
SENTINEL_SQLMAP_BUDGET_MS="480000"          # overall wall-clock budget for sqlmap
